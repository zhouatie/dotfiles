[core]
	pager = delta
	excludesfile = ~/.config/git/ignore

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
  line-numbers = true
    ; dark = true      # or light = true, or omit for auto-detection
  ; side-by-side = true

[merge]
	conflictStyle = zdiff3

[includeIf "hasconfig:remote.*.url:https://github.com/**"]
    path = ~/.config/git/config.github

[includeIf "hasconfig:remote.*.url:git@github.com:*/**"]
    path = ~/.config/git/config.github

[includeIf "hasconfig:remote.*.url:ssh://git@g.hz.netease.com:22222/**"]
    path = ~/.config/git/config.netease.local

[includeIf "hasconfig:remote.*.url:git@g.hz.netease.com:*/**"]
    path = ~/.config/git/config.netease.local

[includeIf "hasconfig:remote.*.url:https://g.hz.netease.com/**"]
    path = ~/.config/git/config.netease.local

[diff "xlsx"]
	textconv = xlsx2csv
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[notes]
	rewriteRef = refs/notes/ai
[notes "rewrite"]
	rebase = true
	amend = true
[user]
	name = zhouatie
	email = zhouatie@gmail.com
[trace2]
	eventTarget = af_unix:stream:/Users/zhoushitie/.git-ai/internal/daemon/trace2.sock
	eventNesting = 10
