{
  "lastChangelogVersion": "1.0.1",
  "defaultProvider": "magpie",
  "defaultModel": "antigravity/gemini-3.8-flash",
  "defaultThinkingLevel": "high",
  "enabledModels": [
    "deepseek/deepseek-v4.1-flash-expires-on-0910",
    "langbase/deepseek-flash",
    "antigravity/gemini-3.8-flash",
    "antigravity-manager/gemini-3.8-flash-high",
    "magpie/antigravity/gemini-3.8-flash",
    "magpie/antigravity/claude-sonnet-4-6"
  ],
  "packages": [
    "npm:pi-subagents@0.49.0",
    "npm:pi-web-access",
    "npm:pi-mcp-adapter",
    {
      "source": "npm:@diegopetrucci/pi-openai-fast@0.1.11",
      "extensions": [
        "-index.ts"
      ]
    },
    "npm:pi-playwright",
    "npm:pi-visualize-code-changes",
    {
      "source": "npm:pi-vision-handoff",
      "extensions": [
        "-vision-handoff.ts"
      ]
    },
    {
      "source": "npm:pi-token-speed",
      "extensions": [
        "-index.ts"
      ]
    },
    "npm:pi-extmgr",
    "npm:pi-open-tui",
    "npm:pi-side-chat",
    {
      "source": "npm:pi-prompt-template-model",
      "extensions": [
        "-index.ts"
      ]
    },
    "npm:pi-antigravity",
    "npm:@ff-labs/pi-fff",
    "npm:pi-tool-repair",
    "npm:@lucascardozo/pi-edit-guard",
    "npm:pi-observational-memory",
    "npm:@dietrichgebert/ponytail"
  ],
  "defaultProjectTrust": "always",
  "treeFilterMode": "no-tools",
  "skills": [
    "!{{ .chezmoi.homeDir }}/.agents/skills/**"
  ],
  "showCacheMissNotices": false,
  "subagents": {
    "defaultModel": "antigravity/gemini-3.8-flash",
    "defaultThinking": "high",
    "agentOverrides": {
      "scout": {
        "tools": [
          "read",
          "grep",
          "find",
          "ls"
        ]
      }
    }
  },
  "terminal": {
    "showTerminalProgress": false
  },
  "transport": "auto",
  "hideThinkingBlock": false,
  "theme": {{ if eq .chezmoi.os "linux" }}"omarchy-system"{{ else }}"omp-titanium"{{ end }},
  "doubleEscapeAction": "tree",
  "showHardwareCursor": true,
  "fullscreenScrollbar": "always",
  "tuiMode": "fullscreen"
}