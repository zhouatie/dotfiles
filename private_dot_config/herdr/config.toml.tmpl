onboarding = false
[ui]
agent_panel_sort = "priority"
right_click_passthrough_modifier = "ctrl"

show_agent_labels_on_pane_borders = false
[keys]
prefix = "ctrl+a"
# macOS 上原来用 cmd+s，但在 Hyprland（Omarchy）里 SUPER+S 被合成器占用（Toggle scratchpad），
# 按键到不了 herdr，所以 Linux 统一用 ctrl+a；macOS 需要时在 ~/.zshrc.local 一类的地方单独设。

# Switch tabs with Ctrl+[ (previous) and Ctrl+] (next)
previous_tab = "ctrl+["
next_tab = "ctrl+]"

# 原来的 previous_agent/next_agent（cmd+ctrl+[ / ]）与 previous_workspace/next_workspace
# （cmd+shift+ctrl+[ / ]）是 macOS 专用 Super 组合，在 Hyprland 上会被合成器拦下，已移除。
# 需要的话改成 ctrl+alt+[ / ctrl+shift+[ 这类组合。

[[keys.command]]
key = "prefix+e"
type = "plugin_action"
command = "chmarax.herdr-nvim.toggle"
description = "nvim sidebar"

[[keys.command]]
key = "prefix+o"
type = "plugin_action"
command = "chmarax.herdr-nvim.pick-file"
description = "open file from agent output"

[[keys.command]] # open in a split pane
key = "prefix+y"
type = "plugin_action"
command = "ray.file-explorer.open"
description = "open file explorer"

[[keys.command]] # open in a new tab
key = "prefix+Y"
type = "plugin_action"
command = "ray.file-explorer.open-tab"
description = "open file explorer in a new tab"

{{- if eq .chezmoi.os "linux" }}
# 使用终端调色板（跟随底层终端 Kitty / Omarchy 配色）
[theme]
name = "terminal"
{{- else }}
# 显式声明深色主题
[theme]
name = "catppuccin"
{{- end }}

auto_switch = false
[ui.toast]
delivery = "system"

[experimental]
kitty_graphics = true

# Worktree plugin bindings (added by config task)
[[keys.command]]
key = "prefix+shift+g"
type = "plugin_action"
command = "worktrunk.open"
description = "Worktree: switch / create from default branch"

# Herdr Board kanban overlay
[[keys.command]]
key = "prefix+shift+k"
type = "shell"
command = "herdr plugin action invoke open-board --plugin herdr-board"
description = "open herdr-board kanban (overlay)"

# 原来的 cmd+shift+k（直接开 board）在 Hyprland 上不生效，已移除；用上面的 prefix+shift+k。

#
# [[keys.command]]
# key = "prefix+shift+c"
# type = "plugin_action"
# command = "worktrunk.open-current"
# description = "Worktree: switch / create from current branch"
#
# [[keys.command]]
# key = "prefix+shift+d"
# type = "plugin_action"
# command = "worktrunk.remove"
# description = "Worktree: remove"

{{- if eq .chezmoi.os "linux" }}
[terminal]
default_shell = "/usr/bin/zsh"
{{- end }}
