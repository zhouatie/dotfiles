# ----- Shell options ----------------------------------------------------------
# 对齐 Omarchy 的 bash 历史设置（HISTSIZE/HISTFILESIZE = 32768）
HISTFILE="$HOME/.zsh_history"
HISTSIZE=32768
SAVEHIST=32768
setopt hist_ignore_dups share_history append_history extended_history

# ----- Prompt & Completion ----------------------------------------------------
[[ -f ~/.zshrc.local.pre ]] && source ~/.zshrc.local.pre

autoload -Uz compinit
if [[ -f ${ZDOTDIR:-$HOME}/.zcompdump ]]; then
  compinit -C
else
  compinit
fi

if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

# mise 是 Omarchy 的工具链管理器（node/python/ruby 等），取代 nvm/rbenv
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

# ----- Path Helpers -----------------------------------------------------------
typeset -U path PATH

path_prepend() {
  local dir="${1/#\~/$HOME}"
  [[ -z "$dir" ]] && return
  case ":$PATH:" in
    *":$dir:"*) ;;
    *) PATH="$dir:$PATH" ;;
  esac
}

path_append() {
  local dir="${1/#\~/$HOME}"
  [[ -z "$dir" ]] && return
  case ":$PATH:" in
    *":$dir:"*) ;;
    *) PATH="$PATH:$dir" ;;
  esac
}

# ----- Core Environment -------------------------------------------------------
export WORK="$HOME/Work"
export EDITOR="nvim"

export ANDROID_HOME="$HOME/Android/Sdk"
if [[ -d "$ANDROID_HOME" ]]; then
  export ANDROID_SDK_ROOT="$ANDROID_HOME"
  for dir in \
    "$ANDROID_HOME/emulator" \
    "$ANDROID_HOME/tools" \
    "$ANDROID_HOME/tools/bin" \
    "$ANDROID_HOME/platform-tools"
  do
    path_append "$dir"
  done
fi
path_append "$HOME/.fzf/bin"

[[ -d /usr/lib/jvm/default ]] && export JAVA_HOME=/usr/lib/jvm/default && path_append "$JAVA_HOME/bin"
export PNPM_HOME="$HOME/.local/share/pnpm"
path_append "$HOME/.cargo/bin"
path_append "$HOME/.local/bin"
path_append "$HOME/.npm-global/bin"

case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) PATH="$PNPM_HOME:$PATH" ;;
esac

# export HTTP_PROXY=http://127.0.0.1:7890
# export HTTPS_PROXY=http://127.0.0.1:7890
# export HTTP_PROXY=http://127.0.0.1:8899
# export HTTPS_PROXY=http://127.0.0.1:8899

export GOOGLE_CLOUD_PROJECT="atie-457613"
# export HOST="127.0.0.1"
# export PORT="3456"
# export LOG="true"
export API_TIMEOUT_MS="30000"

[[ -f ~/.api_keys ]] && source ~/.api_keys

# ----- Aliases ----------------------------------------------------------------
alias v='nvim'
alias cat='bat'
alias cdw='cd "$WORK"'
alias cdp='cd "$HOME/Projects"'
alias tma='tmux attach'
alias tmk='tmux kill-session -t '
alias ls="eza --icons=always"
# prettier 格式化
alias formatFile="prettier --write \"src/**/*.{js,jsx,ts,tsx,less,json,md}\""
alias format="prettier --write src"

# ----- Navigation -------------------------------------------------------------
y() {
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
  yazi "$@" --cwd-file="$tmp"
  IFS= read -r -d '' cwd < "$tmp"
  [[ -n "$cwd" && "$cwd" != "$PWD" ]] && builtin cd -- "$cwd"
  rm -f -- "$tmp"
}

if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
  alias cd="z"
fi

# ----- Prompt & Visuals -------------------------------------------------------
# Arch 的 bat 不带 tokyonight 主题；用 ansi 跟随终端配色（Omarchy 会动态改终端调色板）
export BAT_THEME=ansi

# ----- Tools & Plugins --------------------------------------------------------

if command -v fzf >/dev/null 2>&1; then
  [[ -r /usr/share/fzf/completion.zsh ]] && source /usr/share/fzf/completion.zsh
  [[ -r /usr/share/fzf/key-bindings.zsh ]] && source /usr/share/fzf/key-bindings.zsh
fi

fg="#CBE0F0"
bg="#011628"
bg_highlight="#143652"
purple="#B388FF"
blue="#06BCE4"
cyan="#2CF9ED"

export FZF_DEFAULT_OPTS="--color=fg:${fg},bg:${bg},hl:${purple},fg+:${fg},bg+:${bg_highlight},hl+:${purple},info:${blue},prompt:${cyan},pointer:${cyan},marker:${cyan},spinner:${cyan},header:${cyan}"
export FZF_DEFAULT_COMMAND="fd --hidden --strip-cwd-prefix --exclude .git"
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND="fd --type=d --hidden --strip-cwd-prefix --exclude .git"

show_file_or_dir_preview="if [ -d {} ]; then eza --tree --color=always {} | head -200; else bat -n --color=always --line-range :500 {}; fi"

export FZF_CTRL_T_OPTS="--preview '$show_file_or_dir_preview'"
export FZF_ALT_C_OPTS="--preview 'eza --tree --color=always {} | head -200'"

_fzf_compgen_path() {
  fd --hidden --exclude .git . "$1"
}

_fzf_compgen_dir() {
  fd --type=d --hidden --exclude .git . "$1"
}

_fzf_comprun() {
  local command=$1
  shift

  case "$command" in
    cd)           fzf --preview 'eza --tree --color=always {} | head -200' "$@" ;;
    export|unset) fzf --preview "eval 'echo \${}'" "$@" ;;
    ssh)          fzf --preview 'command -v dig >/dev/null 2>&1 && dig {} || getent hosts {}' "$@" ;;
    *)            fzf --preview "$show_file_or_dir_preview" "$@" ;;
  esac
}

[[ -r ~/fzf-git.sh/fzf-git.sh ]] && source ~/fzf-git.sh/fzf-git.sh

# ----- Misc -------------------------------------------------------------------

_zsh_autosuggestions=/usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
_zsh_syntax_highlighting=/usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

if [[ -r $_zsh_autosuggestions ]]; then
  source $_zsh_autosuggestions
fi

if [[ -r $_zsh_syntax_highlighting ]]; then
  source $_zsh_syntax_highlighting
fi
unset _zsh_autosuggestions _zsh_syntax_highlighting

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# ----- Ruby -------------------------------------------------------------------
export RBENV_ROOT="$HOME/.rbenv"
if command -v rbenv >/dev/null 2>&1; then
  eval "$(rbenv init - zsh)"
fi

if [[ -r "$HOME/.atuin/bin/env" ]]; then
  . "$HOME/.atuin/bin/env"
fi

if command -v atuin >/dev/null 2>&1; then
  eval "$(atuin init zsh)"
fi

[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

# 本机脚本目录（hm-build 等；~/.local/bin 已在上面的 path_append 中）
export PATH="$HOME/.config/scripts:$PATH"

