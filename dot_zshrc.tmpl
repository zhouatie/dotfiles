  eval "$(starship init zsh)"
fi

# ----- Path Helpers -----------------------------------------------------------
typeset -U path PATH

path_prepend() {
  local dir="${1/#\~/$HOME}"
  [[ -z "$dir" ]] && return
  case ":$PATH:" in
    *":$dir:"*) ;;
    *) PATH="$dir:$PATH" ;;
  esac
}

path_append() {
  local dir="${1/#\~/$HOME}"
  [[ -z "$dir" ]] && return
  case ":$PATH:" in
    *":$dir:"*) ;;
    *) PATH="$PATH:$dir" ;;
  esac
}

# ----- Core Environment -------------------------------------------------------
export WORK="$HOME/Work"
export EDITOR="nvim"

export ANDROID_HOME="$HOME/Android/Sdk"
if [[ -d "$ANDROID_HOME" ]]; then
  export ANDROID_SDK_ROOT="$ANDROID_HOME"
  for dir in \
    "$ANDROID_HOME/emulator" \
    "$ANDROID_HOME/tools" \
    "$ANDROID_HOME/tools/bin" \
    "$ANDROID_HOME/platform-tools"
  do
    path_append "$dir"
  done
fi
path_append "$HOME/.fzf/bin"

[[ -d /usr/lib/jvm/default ]] && export JAVA_HOME=/usr/lib/jvm/default && path_append "$JAVA_HOME/bin"
export PNPM_HOME="$HOME/.local/share/pnpm"
path_append "$HOME/.cargo/bin"
