# OpenSpec init with Chinese spec config
specinit() {
  local target="${1:-.}"

  openspec init "$target"
  mkdir -p "$target/openspec"
  cp "$HOME/.config/openspec/config.yaml" "$target/openspec/config.yaml"
}

