alias pi-popo="PI_CODING_AGENT_DIR={{ .chezmoi.homeDir }}/.config/pi-bots/popo pi"
alias pi-ops="PI_CODING_AGENT_DIR={{ .chezmoi.homeDir }}/.config/pi-bots/ops pi"
alias pi-pm="PI_CODING_AGENT_DIR={{ .chezmoi.homeDir }}/.config/pi-bots/pm pi"
alias call-bot="~/.config/pi-bots/call-bot.sh"
